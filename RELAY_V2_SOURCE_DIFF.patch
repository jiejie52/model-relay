+        prompt_details = usage.get("prompt_tokens_details")
+        if isinstance(prompt_details, dict) and prompt_details.get("cached_tokens") is not None:
+            try:
+                cached_tokens = int(prompt_details["cached_tokens"])
+            except Exception:
