diff -ruN '--exclude=__pycache__' '--exclude=*.pyc' '--exclude=RELAY_V2_SOURCE_DIFF.patch' model-relay_0903_extracted/model-relay/app/execution/errors.py model-relay-v2/app/execution/errors.py
