# Model Relay 0.3 - example environment
# Never commit real secrets. Copy to .env only for local development.

RELAY_API_TOKEN=replace-with-a-long-random-token

# Official Moonshot/Kimi profile. Required only when provider=moonshot/kimi is used.
MOONSHOT_API_KEY=replace-me
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Existing AIHubMix/OpenAI-compatible profile. Optional for Kimi-only deployments.
AIHUBMIX_API_KEY=
AIHUBMIX_OPENAI_BASE_URL=https://aihubmix.com/v1

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_BUCKET=dify-assets
SUPABASE_SIGNED_URL_TTL=604800

RELAY_STORAGE_PREFIX=relay

WORKER_MAX_RUNTIME_SECONDS=2400
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_TTL_SECONDS=604800
SESSION_TTL_SECONDS=604800
SESSION_EXPIRY_SAFETY_SECONDS=900

RELAY_RESULT_SOFT_LIMIT_BYTES=524288
RELAY_RESULT_HARD_LIMIT_BYTES=786432
RELAY_RESULT_PREVIEW_BYTES=307200
# Provider errors are not normalized. This only controls inline size in the JSON
# envelope; larger raw bodies remain retrievable from the authenticated raw endpoint.
RELAY_RAW_ERROR_INLINE_LIMIT_BYTES=262144

UPSTREAM_CONNECT_TIMEOUT_SECONDS=30
UPSTREAM_WRITE_TIMEOUT_SECONDS=120
UPSTREAM_POOL_TIMEOUT_SECONDS=30
SUPABASE_TIMEOUT_SECONDS=60

# Used to isolate new Core jobs from compatibility/Fusion jobs during rolling upgrade.
CORE_EXECUTION_ENGINE=core-v2
LEGACY_CORE_EXECUTION_ENGINE=core-legacy-v1
LEGACY_FUSION_EXECUTION_ENGINE=fusion-legacy-v1

LOG_LEVEL=INFO
