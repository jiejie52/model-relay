# Never commit real secrets. Copy this to .env only for local development.

RELAY_API_TOKEN=replace-with-a-long-random-token

AIHUBMIX_API_KEY=replace-me
AIHUBMIX_OPENAI_BASE_URL=https://aihubmix.com/v1

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_BUCKET=dify-assets
SUPABASE_SIGNED_URL_TTL=604800

RELAY_STORAGE_PREFIX=relay

WORKER_MAX_RUNTIME_SECONDS=2400
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_TTL_SECONDS=604800
SESSION_TTL_SECONDS=604800
SESSION_EXPIRY_SAFETY_SECONDS=900

RELAY_RESULT_SOFT_LIMIT_BYTES=524288
RELAY_RESULT_HARD_LIMIT_BYTES=786432
RELAY_RESULT_PREVIEW_BYTES=307200

UPSTREAM_CONNECT_TIMEOUT_SECONDS=30
UPSTREAM_WRITE_TIMEOUT_SECONDS=120
UPSTREAM_POOL_TIMEOUT_SECONDS=30
SUPABASE_TIMEOUT_SECONDS=60

LOG_LEVEL=INFO

# Fusion Runtime uses the same provider/Supabase credentials and adds no new secret.

# V20.25.23 Fusion Async Resume callback to the SAME Dify Chatflow app.
# DIFY_CALLBACK_BASE_URL example: https://api.dify.ai/v1 or https://dify.example.com/v1
DIFY_CALLBACK_ENABLED=false
DIFY_CALLBACK_BASE_URL=
DIFY_CALLBACK_API_KEY=
DIFY_CALLBACK_TIMEOUT_SECONDS=900
DIFY_CALLBACK_CONNECT_TIMEOUT_SECONDS=30
DIFY_CALLBACK_POLL_SECONDS=2
DIFY_CALLBACK_MAX_ATTEMPTS=8
DIFY_CALLBACK_BASE_BACKOFF_SECONDS=5
DIFY_CALLBACK_MAX_BACKOFF_SECONDS=300
DIFY_CALLBACK_LEASE_SECONDS=180
