# Model Relay V2 example configuration. Never commit real secrets.

# Relay API auth. For a single-tenant server-to-server token, bind the token to
# that tenant so X-Tenant-Id cannot be freely asserted by a caller.
RELAY_API_TOKEN=replace-with-a-long-random-token
RELAY_ALLOWED_TENANT_ID=replace-with-your-tenant-id

# Supabase remains the control DB + execution archive.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_BUCKET=dify-assets
SUPABASE_SIGNED_URL_TTL=604800
RELAY_STORAGE_PREFIX=relay

# Railway private Storage Bucket (S3-compatible): canonical uploaded materials only.
# Preferred explicit V2 names:
MATERIAL_S3_ENDPOINT=https://replace-with-railway-bucket-endpoint
MATERIAL_S3_BUCKET=replace-with-bucket
MATERIAL_S3_REGION=auto
MATERIAL_S3_ADDRESSING_STYLE=auto
MATERIAL_S3_ACCESS_KEY_ID=replace-me
MATERIAL_S3_SECRET_ACCESS_KEY=replace-me
#
# Hotfix5 also accepts Railway bucket variable references directly:
# ENDPOINT / BUCKET / REGION / ACCESS_KEY_ID / SECRET_ACCESS_KEY
# and Railway CLI/AWS-compatible names:
# AWS_ENDPOINT_URL / AWS_S3_BUCKET_NAME / AWS_DEFAULT_REGION /
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_S3_URL_STYLE
# Explicit MATERIAL_S3_* variables take precedence if both forms exist.
MATERIAL_S3_PREFIX=relay-materials
MATERIAL_S3_PRESIGN_SECONDS=3600
MATERIAL_MAX_BYTES=104857600
MATERIAL_FETCH_TIMEOUT_SECONDS=120
MATERIAL_FETCH_CONNECT_TIMEOUT_SECONDS=20
MATERIAL_READY_TTL_SECONDS=2592000
MATERIAL_GC_GRACE_SECONDS=86400
MATERIAL_URL_ALLOWED_PORTS=443
MATERIAL_URL_MAX_REDIRECTS=3

# Official Moonshot/Kimi. Independent from AIHubMix.
MOONSHOT_API_KEY=replace-with-moonshot-key
MOONSHOT_API_ORIGIN=https://api.moonshot.ai/v1

# Existing Grok compatibility/profile via AIHubMix. Optional for Kimi-only deployments.
AIHUBMIX_API_KEY=replace-with-aihubmix-key
AIHUBMIX_OPENAI_BASE_URL=https://aihubmix.com/v1

# Native Gemini V2 profile. Optional if Gemini V2 is not enabled.
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_API_ORIGIN=https://generativelanguage.googleapis.com/v1beta

# Optional JSON object for server-registered profile overrides. Never put raw provider
# secrets in this JSON; credential_ref must point to typed environment variables above.
# PROVIDER_PROFILES_JSON={}

# Queue / lease / execution.
EXECUTION_ENGINE=v2
COMPATIBILITY_ENABLED=true
WORKER_MAX_RUNTIME_SECONDS=2400
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_TTL_SECONDS=604800
SESSION_TTL_SECONDS=604800
SESSION_EXPIRY_SAFETY_SECONDS=900
BINDING_SAFETY_WINDOW=300
BINDING_PREPARE_WAIT_SECONDS=60
PROVIDER_FETCH_URL_TTL=3600

# V1 compact success-result limits. Raw Error delivery does NOT use these truncation limits.
RELAY_RESULT_SOFT_LIMIT_BYTES=524288
RELAY_RESULT_HARD_LIMIT_BYTES=786432
RELAY_RESULT_PREVIEW_BYTES=307200

# Raw Error delivery: auto | inline | reference
RAW_ERROR_DELIVERY=auto
RAW_ERROR_INLINE_MAX_BYTES=262144
ERROR_RETENTION_SECONDS=2592000

# HTTP/Supabase timeouts.
UPSTREAM_CONNECT_TIMEOUT_SECONDS=30
UPSTREAM_WRITE_TIMEOUT_SECONDS=120
UPSTREAM_POOL_TIMEOUT_SECONDS=30
# Leave empty for provider/client default if long-thinking calls need no read timeout.
# UPSTREAM_READ_TIMEOUT_SECONDS=
SUPABASE_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
