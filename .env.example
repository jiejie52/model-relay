# Never commit real secrets.
RELAY_API_TOKEN=replace-with-a-long-random-token

# Deployment identity / claim scope. Use the same image in Railway and SAE.
DEPLOYMENT_ID=railway
EXECUTION_POOL=railway-default
WORKER_EXECUTION_POOLS=railway-default
# 0.5.1 default: all server-known connections are eligible. The legacy
# ENABLED_CONNECTIONS variable is ignored unless CONNECTION_AVAILABILITY_MODE
# is explicitly changed to allowlist. This avoids stale deployment variables
# accidentally deleting a valid provider route.
CONNECTION_AVAILABILITY_MODE=all
ENABLED_CONNECTIONS=aihubmix_default
DEFAULT_CONNECTION_ID=aihubmix_default

# Public route contract 2.1. Dify sends provider/model; Relay resolves the
# private connection. Keep warn during migration; switch to strict after Dify
# stops sending legacy connection_id/target_connection_id hints.
ROUTE_REVISION=relay-route-catalog/2026-09-21.2
ROUTE_LEGACY_HINT_MODE=warn
ROUTE_GEMINI_MODEL_PATTERN=gemini-*
ROUTE_GROK_MODEL_PATTERN=grok-*
ROUTE_KIMI_MODEL_PATTERN=kimi-*
# Optional full server-side override. Example:
# ROUTE_CATALOG_JSON={"revision":"relay-route-catalog/custom-1","routes":[{"provider":"gemini","model_pattern":"gemini-*","connection_id":"aihubmix_gemini_native","priority":100,"requires_file_adapter":true}]}

# Existing Railway / AIHubMix connection. A route is usable when its required
# server credentials/endpoints are configured; no separate enable-list is needed
# in the default connection mode.
AIHUBMIX_API_KEY=replace-me
AIHUBMIX_OPENAI_BASE_URL=https://aihubmix.com/v1
# Required when Gemini is actually used. Use the exact AIHubMix Gemini Native
# Proxy base URL from your working workflow/account.
AIHUBMIX_GEMINI_BASE_URL=
AIHUBMIX_GEMINI_CONNECTION_ID=aihubmix_gemini_native

# Official Moonshot/Kimi connection. Configure it on any deployment that will
# actually serve Kimi; no enable-list change is required in default mode.
MOONSHOT_API_KEY=replace-me
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_CONNECTION_ID=moonshot_official

# Shared control plane + current shared object storage.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_BUCKET=dify-assets
SUPABASE_SIGNED_URL_TTL=604800
DEFAULT_STORAGE_ID=supabase_shared
RELAY_STORAGE_PREFIX=relay

WORKER_MAX_RUNTIME_SECONDS=2400
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_TTL_SECONDS=604800
SESSION_TTL_SECONDS=604800
SESSION_EXPIRY_SAFETY_SECONDS=900
SYNC_REQUEST_DEADLINE_SECONDS=120

MATERIAL_INGRESS_MAX_BYTES=104857600
MATERIAL_INGRESS_TIMEOUT_SECONDS=120
MATERIAL_ALLOW_HTTP=false
MATERIAL_DEFAULT_DURABILITY_POLICY=native_first
MATERIAL_DEFAULT_FALLBACK_POLICY=on_provider_unavailable
GEMINI_FILE_SOFT_TTL_SECONDS=172800
GEMINI_FILE_POLL_SECONDS=2
GEMINI_FILE_PROCESSING_TIMEOUT_SECONDS=300
KIMI_FILE_POLL_SECONDS=2
KIMI_FILE_PROCESSING_TIMEOUT_SECONDS=300

RELAY_RESULT_SOFT_LIMIT_BYTES=524288
RELAY_RESULT_HARD_LIMIT_BYTES=786432
RELAY_RESULT_PREVIEW_BYTES=307200

UPSTREAM_CONNECT_TIMEOUT_SECONDS=30
UPSTREAM_WRITE_TIMEOUT_SECONDS=120
UPSTREAM_POOL_TIMEOUT_SECONDS=30
SUPABASE_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
# Suppress high-frequency httpx/httpcore access logs (including Supabase
# claim_relay_job_v2 polling). Set to INFO only for temporary HTTP wire debugging.
DEPENDENCY_HTTP_LOG_LEVEL=WARNING
# Relay emits its own lifecycle logs, so Uvicorn access logs are disabled by default.
UVICORN_ACCESS_LOG=false
