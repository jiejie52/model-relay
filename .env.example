# Never commit real secrets.
RELAY_API_TOKEN=replace-with-a-long-random-token

# Deployment identity / claim scope. Use the same image in Railway and SAE.
DEPLOYMENT_ID=railway
EXECUTION_POOL=railway-default
WORKER_EXECUTION_POOLS=railway-default
ENABLED_CONNECTIONS=aihubmix_default
DEFAULT_CONNECTION_ID=aihubmix_default

# Existing Railway / AIHubMix connection (optional if not enabled here).
AIHUBMIX_API_KEY=replace-me
AIHUBMIX_OPENAI_BASE_URL=https://aihubmix.com/v1

# Official Moonshot/Kimi connection (enable on SAE or any deployment that needs it).
# ENABLED_CONNECTIONS=moonshot_official
# DEFAULT_CONNECTION_ID=moonshot_official
MOONSHOT_API_KEY=replace-me
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# Shared control plane + current shared object storage.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_BUCKET=dify-assets
SUPABASE_SIGNED_URL_TTL=604800
DEFAULT_STORAGE_ID=supabase_shared
RELAY_STORAGE_PREFIX=relay

WORKER_MAX_RUNTIME_SECONDS=2400
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_TTL_SECONDS=604800
SESSION_TTL_SECONDS=604800
SESSION_EXPIRY_SAFETY_SECONDS=900
SYNC_REQUEST_DEADLINE_SECONDS=120

MATERIAL_INGRESS_MAX_BYTES=104857600
MATERIAL_INGRESS_TIMEOUT_SECONDS=120
MATERIAL_ALLOW_HTTP=false

RELAY_RESULT_SOFT_LIMIT_BYTES=524288
RELAY_RESULT_HARD_LIMIT_BYTES=786432
RELAY_RESULT_PREVIEW_BYTES=307200

UPSTREAM_CONNECT_TIMEOUT_SECONDS=30
UPSTREAM_WRITE_TIMEOUT_SECONDS=120
UPSTREAM_POOL_TIMEOUT_SECONDS=30
SUPABASE_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
